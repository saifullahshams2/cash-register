<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive files and directories
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|CLAUDE\.md|AGENTS\.md|README\.md|app/|bootstrap/|config/|database/|resources/|routes/|storage/|tests/|.*\.zip$) - [F,L,NC]

    # Forward non-public asset requests to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
