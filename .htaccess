<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive files and directories
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|artisan|database/|storage/logs/|.*\.zip$) - [F,L,NC]

    # Forward non-public asset requests to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/ [L]
</IfModule>
