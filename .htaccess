<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Prevent direct access to all hidden files/directories (.env, .git, etc.)
    RewriteRule (^\.|/\.) - [F,L]

    # Prevent direct access to databases, logs, archives, backups, and config files
    RewriteRule \.(sqlite|sqlite3|db|log|zip|tar|gz|sql|bak|old|swp)$ - [F,L,NC]
    RewriteRule ^(database/|storage/logs/|storage/framework/|storage/app/private/) - [F,L,NC]
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|vite\.config\.js|boost\.json|skills\.md|AGENTS\.md|CLAUDE\.md|README\.md) - [F,L,NC]

    # If the request is not already pointing to /public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
